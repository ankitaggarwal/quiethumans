# Copy this file to backend/.env and fill in your own values.

# --- Database ---
# Production uses PostgreSQL. For zero-setup local development you can instead
# point this at a SQLite file: DATABASE_URL=sqlite:///quiethumans.db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Vector search (Qdrant) ---
QDRANT_URL=https://your-qdrant-host
QDRANT_KEY=your-qdrant-api-key
QDRANT_COLLECTION=quiet-humans

# --- Self-hosted, OpenAI-compatible LLM (chat + embeddings) ---
# One endpoint serves generation (/v1/chat/completions) and embeddings
# (/v1/embeddings). The embedding model must output 768-dimensional vectors.
LOCAL_LLM_URL=https://your-llm-host
LOCAL_LLM_KEY=your-llm-bearer-token
LOCAL_LLM_MODEL=gemma4:e4b

# --- Optional ---
# GitHub token raises the API rate limit (60/hr -> 5000/hr) for enrichment.
GITHUB_TOKEN=

# Bearer token that gates the MCP server. Leave empty to disable MCP entirely.
MCP_TOKEN=
